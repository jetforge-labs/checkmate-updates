        <item>
            <title>1.1.0</title>
            <pubDate>Wed, 28 Oct 2026 16:44:50 +0100</pubDate>
            <sparkle:version>2</sparkle:version>
            <sparkle:shortVersionString>1.1.0</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>15.0</sparkle:minimumSystemVersion>
            <description><![CDATA[<h2>Checkmate 1.1.0</h2>
<ul>
<li>Checkmate now speaks English, Français, Português, Italiano and Deutsch. Choose the language in Settings &rsaquo; General.</li>
</ul>
